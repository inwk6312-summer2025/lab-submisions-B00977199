[2863.650579, "o", "\u001b[?25l\u001b[1;1H\u001b[K\u001b[2;1H\u001b[34m# Configure logging\u001b[m\r\nlogging.basicConfig(level=logging.INFO, \u001b[36mformat\u001b[m=\u001b[31m'%(name)s - %(levelname)s - %(message)s'\u001b[m)\u001b[3;89H\u001b[K\u001b[4;1H\u001b[K\u001b[5;1H\u001b[34m# Load the YAML configuration\u001b[m\u001b[5;30H\u001b[K\u001b[6;1H\u001b[33mwith\u001b[m \u001b[36mopen\u001b[m(\u001b[31m'router_ips.yml'\u001b[m, \u001b[31m'r'\u001b[m) \u001b[33mas\u001b[m \u001b[36mfile\u001b[m:\u001b[6;42H\u001b[K\u001b[7;1H    router_data = yaml.safe_load(\u001b[36mfile\u001b[m)\u001b[7;39H\u001b[K\u001b[8;1H\u001b[K\u001b[9;1H    \u001b[34m# RESTCONF Configuration\u001b[m\u001b[9;29H\u001b[K\u001b[10;1H    USER = \u001b[31m'student'\u001b[m\u001b[10;21H\u001b[K\u001b[11;1H    PASS = \u001b[31m'Meilab123'\u001b[m\u001b[11;23H\u001b[K\u001b[12;1H    BASE_URL = \u001b[31m'http://{0}/restconf/api/running/'\u001b[m.format\u001b[12;57H\u001b[K\u001b[13;1H\u001b[K\u001b[14;1H    \u001b[33mdef\u001b[m \u001b[36mset_interface_ip\u001b[m(router_ip, interface_name, ip_address, netmask):\u001b[14;74H\u001b[K\u001b[15;1H        \u001b[31m\"\"\"Function to set the interface IP address using RESTCONF.\"\"\"\u001b[m\u001b[15;71H\u001b[K\u001b[16;1H        url = BASE_URL(router_ip) + \u001b[31m\"interfaces/interface/\"\u001b[m + interface_name\u001b[16;77H\u001b[K\u001b[17;1H        auth = HTTPBasicAuth(USER, PASS)\u001b[17;41H\u001b[K\u001b[18;1H        header"]
[2863.65171, "o", "s = {\u001b[18;20H\u001b[K\u001b[19;1H                \u001b[31m'Accept'\u001b[m: \u001b[31m'application/vnd.yang.data+json'\u001b[m,\u001b[19;60H\u001b[K\u001b[20;1H                \u001b[31m'Content-Type'\u001b[m: \u001b[31m'application/vnd.yang.data+json'\u001b[m\u001b[20;65H\u001b[K\u001b[21;1H                }\u001b[21;18H\u001b[K\u001b[22;1H        data = {\u001b[22;17H\u001b[K\u001b[23;1H                \u001b[31m\"ietf-interfaces:interface\"\u001b[m: {\u001b[23;47H\u001b[K\u001b[24;1H                    \u001b[31m\"name\"\u001b[m: interface_name,\u001b[24;44H\u001b[K\u001b[25;1H                    \u001b[31m\"description\"\u001b[m: f\u001b[31m\"Configured via RESTCONF\"\u001b[m,\u001b[25;63H\u001b[K\u001b[26;1H                    \u001b[31m\"type\"\u001b[m: \u001b[31m\"iana-if-type:ethernetCsmacd\"\u001b[m,\u001b[26;59H\u001b[K\u001b[27;1H                    \u001b[31m\"enabled\"\u001b[m: \u001b[36mTrue\u001b[m,\u001b[27;37H\u001b[K\u001b[28;1H                    \u001b[31m\"ietf-ip:ipv4\"\u001b[m: {\u001b[28;38H\u001b[K\u001b[29;1H                        \u001b[31m\"address\"\u001b[m: [\u001b[29;37H\u001b[K\u001b[30;1H                            {\u001b[30;30H\u001b[K\u001b[31;1H                                \u001b[31m\"ip\"\u001b[m: ip_address,\u001b[31;50H\u001b[K\u001b[32;1H                                 "]
[2863.654888, "o", "\u001b[31m\"netmask\"\u001b[m: netmask\u001b[32;52H\u001b[K\u001b[33;1H                                 }\u001b[33;35H\u001b[K\u001b[34;1H                            ]\u001b[34;30H\u001b[K\u001b[35;1H                        }\u001b[35;26H\u001b[K\u001b[36;1H                    }\u001b[36;22H\u001b[K\u001b[37;1H                }\u001b[37;18H\u001b[K\u001b[38;1H        logging.info(f\u001b[31m\"Setting {interface_name} IP to {ip_address} on {router_ip}\"\u001b[m)\u001b[38;84H\u001b[K\u001b[39;1H        response = requests.put(url, auth=auth, headers=headers, data=json.dumps(data))\u001b[39;88H\u001b[K\u001b[40;1H        \u001b[33mif\u001b[m response.status_code == \u001b[31m204\u001b[m:\u001b[40;40H\u001b[K\u001b[41;1H            logging.info(f\u001b[31m\"Successfully set {interface_name} IP on {router_ip}, Status Code: {response.status_code}\"\"\u001b[m\u001b[42;1H)\u001b[42;2H\u001b[K\u001b[43;1H        \u001b[33melse\u001b[m:\u001b[43;14H\u001b[K\u001b[44;1H            logging.error(f\u001b[31m\"Failed to set {interface_name} IP on {router_ip}, Status Code: {response.status_code}, RR\u001b[45;1Hesponse: {response.text}\"\u001b[m)\u001b[45;27H\u001b[K\u001b[46;1H            \u001b[33mdef\u001b[m \u001b[36mupdate_router_interfaces\u001b[m():\u001b[46;44H\u001b[K\u001b[47;1H                \u001b[31m\"\"\"Iterates th"]
