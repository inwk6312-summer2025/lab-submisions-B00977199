[3270.183789, "o", "\u001b[1;1H\u001b[35mimport\u001b[m logging\r\n\u001b[35mimport\u001b[m requests\r\n\u001b[35mfrom\u001b[m requests.auth \u001b[35mimport\u001b[m HTTPBasicAuth\r\n\u001b[35mimport\u001b[m json\r\n\u001b[35mimport\u001b[m yaml\r\n\r\n\u001b[34m# Configure logging\u001b[m\r\nlogging.basicConfig(level=logging.INFO, \u001b[36mformat\u001b[m=\u001b[31m'%(name)s - %(levelname)s - %(message)s'\u001b[m)\r\n\r\n\u001b[34m# Load the YAML configuration\u001b[m\r\n\u001b[33mwith\u001b[m \u001b[36mopen\u001b[m(\u001b[31m'router.yml'\u001b[m, \u001b[31m'r'\u001b[m) \u001b[33mas\u001b[m \u001b[36mfile\u001b[m:\r\n    router_data = yaml.safe_load(\u001b[36mfile\u001b[m)\u001b[14;5H\u001b[34m# RESTCONF Configuration\u001b[m\r\nUSER = \u001b[31m'student'\u001b[m\r\nPASS = \u001b[31m'Meilab123'\u001b[m\r\nBASE_URL = \u001b[31m'http://{0}/restconf/api/running/'\u001b[m.format\r\n\r\n\u001b[33mdef\u001b[m \u001b[36mset_interface_ip\u001b[m(router_ip, interface_name, ip_address, netmask):\u001b[20;9H\u001b[31m\"\"\"Function to set the interface IP address using RESTCONF.\"\"\"\u001b[m\u001b[21;9Hurl = BASE_URL(router_ip) + \u001b[31m\"interfaces/interface/\"\u001b[m + interface_name\u001b[22;9Hauth = HTTPBasicAuth(USER, PASS)\u001b[23;9Hheaders = {\u001b[24;17H\u001b[31m'Accept'\u001b[m: \u001b[31m'application/vnd.yang.data+json'\u001b[m,\u001b[25;17H\u001b[31m'Content-Type'\u001b[m:"]
[3270.184227, "o", " \u001b[31m'application/vnd.yang.data+json'\u001b[m\u001b[26;17H}\u001b[27;9Hdata = {\u001b[28;17H\u001b[31m\"ietf-interfaces:interface\"\u001b[m: {\u001b[29;21H\u001b[31m\"name\"\u001b[m: interface_name,\u001b[30;21H\u001b[31m\"description\"\u001b[m: f\u001b[31m\"Configured via RESTCONF\"\u001b[m,\u001b[31;21H\u001b[31m\"type\"\u001b[m: \u001b[31m\"iana-if-type:ethernetCsmacd\"\u001b[m,\u001b[32;21H\u001b[31m\"enabled\"\u001b[m: \u001b[36mTrue\u001b[m,\u001b[33;21H\u001b[31m\"ietf-ip:ipv4\"\u001b[m: {\u001b[34;25H\u001b[31m\"address\"\u001b[m: [\u001b[35;29H{\u001b[36;33H\u001b[31m\"ip\"\u001b[m: ip_address,\u001b[37;34H\u001b[31m\"netmask\"\u001b[m: netmask\u001b[38;34H}\u001b[39;29H]\u001b[40;25H}\u001b[41;21H}\u001b[42;17H}\u001b[43;9Hlogging.info(f\u001b[31m\"Setting {interface_name} IP to {ip_address} on {router_ip}\"\u001b[m)\u001b[44;9Hresponse = requests.put(url, auth=auth, headers=headers, data=json.dumps(data))\u001b[45;9H\u001b[33mif\u001b[m response.status_code == \u001b[31m204\u001b[m:\u001b[46;13Hlogging.info(f\u001b[31m\"Successfully set {interface_name} IP on {router_ip}, Status Code: {response.status_code}\"\"\u001b[m\u001b[47;1H)\u001b[48;9H\u001b[33melse\u001b[m:\u001b[49;13Hlogging.error(f\u001b[31m\"Failed to set {interface_name} IP on {router_ip}, Status Code: {response.status_code}, RR"]
[3270.186056, "o", "\u001b[50;1Hesponse: {response.text}\"\u001b[m)\r\n\u001b[33mdef\u001b[m \u001b[36mupdate_router_interfaces\u001b[m():\r\n    \u001b[31m\"\"\"Iterates through the router data and updates the interfaces using RESTCONF.\"\"\"\u001b[m\r\n    \u001b[33mfor\u001b[m router \u001b[33min\u001b[m router_data[\u001b[31m'routers'\u001b[m]:\u001b[54;9Hmanagement_ip = router[\u001b[31m'management_ip'\u001b[m]\u001b[55;9H\u001b[33mfor\u001b[m interface \u001b[33min\u001b[m router[\u001b[31m'interfaces'\u001b[m]:\u001b[56;13Hset_interface_ip(management_ip, interface[\u001b[31m'name'\u001b[m], interface[\u001b[31m'ip_address'\u001b[m], interface[\u001b[31m'netmask'\u001b[m])\u001b[58;99H11,17\u001b[9CTop\u001b[11;17H\u001b[?25h"]
