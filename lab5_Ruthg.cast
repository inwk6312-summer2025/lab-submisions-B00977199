[5132.617486, "o", "\u001b[1;1H\u001b[35mimport\u001b[m yaml\r\n\u001b[35mimport\u001b[m requests\r\n\u001b[35mimport\u001b[m json\r\n\u001b[35mimport\u001b[m logging\r\n\r\n\u001b[34m# Setup logging\u001b[m\r\nlogging.basicConfig(level=logging.INFO)\r\nlogger = logging.getLogger()\r\n\r\n\u001b[34m# RESTCONF headers and auth\u001b[m\r\nHEADERS = {\u001b[12;9H\u001b[31m\"Content-Type\"\u001b[m: \u001b[31m\"application/yang-data+json\"\u001b[m,\u001b[13;9H\u001b[31m\"Accept\"\u001b[m: \u001b[31m\"application/yang-data+json\"\u001b[m\u001b[14;9H}\r\nAUTH = (\u001b[31m\"admin\"\u001b[m, \u001b[31m\"admin\"\u001b[m)  \u001b[34m# Change if needed\u001b[m\r\n\r\n\u001b[33mdef\u001b[m \u001b[36mload_config\u001b[m(file_path):\r\n \u001b[33mwith\u001b[m \u001b[36mopen\u001b[m(file_path) \u001b[33mas\u001b[m f:\r\n  \u001b[33mreturn\u001b[m yaml.safe_load(f)\r\n\r\n\u001b[33mdef\u001b[m \u001b[36mset_interface_ip\u001b[m(router_ip, interface_name, ip_address, netmask):\r\n url = f\u001b[31m\"http://{router_ip}/restconf/data/ietf-interfaces:interfaces/interface={interface_name}\"\u001b[m\u001b[24;13H\u001b[34m# Prepare payload according to RESTCONF yang model\u001b[m\r\n data = {\r\n   \u001b[31m\"ietf-interfaces:interface\"\u001b[m: {\r\n   \u001b[31m\"name\"\u001b[m: interface_name,\r\n   \u001b[31m\"description\"\u001b[m: \u001b[31m\"Configured via RESTCONF\"\u001b[m,\r\n   \u001b[31m\"type\"\u001b[m: \u001b"]
[5132.617915, "o", "[31m\"iana-if-type:ethernetCsmacd\"\u001b[m,\r\n   \u001b[31m\"enabled\"\u001b[m: \u001b[36mTrue\u001b[m,\r\n   \u001b[31m\"ietf-ip:ipv4\"\u001b[m: {\r\n    \u001b[31m\"address\"\u001b[m: [{\u001b[33;7H\u001b[31m\"ip\"\u001b[m: ip_address,\u001b[34;7H\u001b[31m\"netmask\"\u001b[m: netmask\u001b[35;8H}]\u001b[36;7H}\u001b[37;6H}\r\n    }\r\n  \u001b[33mtry\u001b[m:\u001b[40;6Hresponse = requests.put(url, auth=AUTH, headers=HEADERS, data=json.dumps(data))\u001b[41;6H\u001b[33mif\u001b[m response.status_code \u001b[33min\u001b[m [\u001b[31m200\u001b[m, \u001b[31m201\u001b[m, \u001b[31m204\u001b[m]:\u001b[42;7Hlogger.info(f\u001b[31m\"Successfully set {interface_name} on {router_ip}\"\u001b[m)\u001b[43;6H\u001b[33melse\u001b[m:\u001b[44;7Hlogger.error(f\u001b[31m\"Failed to set {interface_name} on {router_ip}, Status Code: {response.status_code}, Response: {{\u001b[45;1Hresponse.text}\"\u001b[m)\r\n  \u001b[33mexcept\u001b[m requests.exceptions.RequestException \u001b[33mas\u001b[m e:\r\n    logger.error(f\u001b[31m\"Request failed for {router_ip}: {e}\"\u001b[m)\r\n\u001b[33mdef\u001b[m \u001b[36mmain\u001b[m():\r\n config = load_config(\u001b[31m\"routers.yml\"\u001b[m)\r\n \u001b[33mfor\u001b[m router \u001b[33min\u001b[m config.get(\u001b[31m'routers'\u001b[m, []):"]
[5132.619293, "o", "\u001b[51;6Hrouter_ip = router[\u001b[31m'management_ip'\u001b[m]\u001b[52;6H\u001b[33mfor\u001b[m interface \u001b[33min\u001b[m router.get(\u001b[31m'interfaces'\u001b[m, []):\u001b[53;7Hset_interface_ip(router_ip, interface[\u001b[31m'name'\u001b[m], interface[\u001b[31m'ip_address'\u001b[m], interface[\u001b[31m'netmask'\u001b[m])\r\n\r\n\u001b[33mif\u001b[m __name__ == \u001b[31m\"__main__\"\u001b[m:\r\n main()\u001b[58;99H25,1\u001b[10CAll\u001b[25;1H\u001b[?25h"]
