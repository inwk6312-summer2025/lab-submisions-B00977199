[2760.73168, "o", "  \u001b[22;1H                                                        ]\u001b[22;58H\u001b[K\u001b[23;1H                                                                                                                     \u001b[24;1H                            }\u001b[24;30H\u001b[K\u001b[25;1H                                                                                                                     \u001b[26;1H    }\u001b[26;6H\u001b[K\u001b[27;1H                                                    }\u001b[27;54H\u001b[K\u001b[28;1H\u001b[K\u001b[29;1H                                    logging.info(f\u001b[31m\"Setting {interface_name} IP to {ip_address} on {router_ip}\"\u001b[m)\u001b[29;112H\u001b[K\u001b[30;1H                                        response = requests.put(url, auth=auth, headers=headers, data=json.dumps(datt\u001b[31;1Ha))\u001b[31;4H\u001b[K\u001b[32;1H\u001b[K\u001b[33;1H                                            \u001b[33mif\u001b[m response.status_code == \u001b[31m204\u001b[m:\u001b[33;76H\u001b[K\u001b[34;1H                                                        logging.info(f\u001b[31m\"Successfully set {interface_name} IP on {routt\u001b[35;1Her_ip}, Stat"]
[2760.732135, "o", "us Code: {response.status_code}\"\u001b[m)\u001b[35;46H\u001b[K\u001b[36;1H                                                            \u001b[33melse\u001b[m:\u001b[36;66H\u001b[K\u001b[37;1H                                                                        logging.error(f\u001b[31m\"Failed to set {interface_namm\u001b[38;1He} IP on {router_ip}, Status Code: {response.status_code}, Response: {response.text}\"\u001b[m)\u001b[38;87H\u001b[K\u001b[39;1H\u001b[K\u001b[40;1H                                                                        \u001b[33mdef\u001b[m \u001b[36mupdate_router_interfaces\u001b[m():\u001b[40;104H\u001b[K\u001b[41;1H                                                                                \u001b[31m\"\"\"Iterates through the router data  \u001b[42;1Hand updates the interfaces using RESTCONF.\"\"\"\u001b[m\u001b[42;46H\u001b[K\u001b[43;1H                                                                                    \u001b[33mfor\u001b[m router \u001b[33min\u001b[m router_data[\u001b[31m'routee\u001b[44;1Hrs'\u001b[m]:\u001b[44;6H\u001b[K\u001b[45;1H                                                                                                management_ip = routt"]
