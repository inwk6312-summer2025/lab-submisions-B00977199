[1373.384003, "o", "\u001b[1;1H\u001b[35mimport\u001b[m logging\r\n\u001b[35mimport\u001b[m requests\r\n\u001b[35mfrom\u001b[m requests.auth \u001b[35mimport\u001b[m HTTPBasicAuth\r\n\u001b[35mimport\u001b[m json\r\nlogging.basicConfig(level=logging.INFO, \u001b[36mformat\u001b[m=\u001b[31m'%(name)s - %(levelname)s - %(message)s'\u001b[m)\r\nHOST = \u001b[31m'192.168.1.101'\u001b[m\r\nUSER = \u001b[31m'student'\u001b[m\r\nPASS = \u001b[31m'Meilab123'\u001b[m\r\nBASE_URL = \u001b[31m'http://{0}/restconf/api/running/'\u001b[m.format(HOST)\r\n\u001b[33mdef\u001b[m \u001b[36mset_interfaces\u001b[m(append_url, interface_name):\r\n    url = BASE_URL + append_url + interface_name\r\n    auth = HTTPBasicAuth(USER, PASS)\r\n    headers = {\u001b[14;13H\u001b[31m'Accept'\u001b[m: \u001b[31m'application/vnd.yang.data+json'\u001b[m,\u001b[15;13H\u001b[31m'Content-Type'\u001b[m: \u001b[31m'application/vnd.yang.data+json'\u001b[m\u001b[16;13H}\r\n    data = {\u001b[18;13H\u001b[31m\"ietf-interfaces:interface\"\u001b[m: {\u001b[19;17H\u001b[31m\"name\"\u001b[m: \u001b[31m\"GigabitEthernet3\"\u001b[m,\u001b[20;17H\u001b[31m\"description\"\u001b[m: \u001b[31m\"Changed through Restconf\"\u001b[m,\u001b[21;17H\u001b[31m\"type\"\u001b[m: \u001b[31m\"iana-if-type:ethernetCsmacd\"\u001b[m,\u001b[22;17H\u001b[31m\"enabled\"\u001b[m: \u001b[31m'true'\u001b[m,\u001b[23;17H\u001b[31m\"ietf-ip:ipv4\"\u001b[m: {\u001b"]
[1373.384444, "o", "[24;21H\u001b[31m\"address\"\u001b[m: [\u001b[25;25H{\u001b[26;29H\u001b[31m\"ip\"\u001b[m: \u001b[31m\"10.0.10.3\"\u001b[m,\u001b[27;29H\u001b[31m\"netmask\"\u001b[m: \u001b[31m\"255.255.255.0\"\u001b[m\u001b[28;29H}\u001b[29;25H]\u001b[30;21H},\u001b[31;17H\u001b[31m\"ietf-ip:ipv6\"\u001b[m: {}\u001b[32;17H}\u001b[33;13H}\u001b[34;7Hresponse = requests.put(url, auth=auth, headers=headers,\r\n    data=json.dumps(data))\r\n    \u001b[33mif\u001b[m response.status_code == \u001b[31m204\u001b[m:\u001b[37;9Hlogging.info(f\u001b[31m\"Request was successful on {HOST}, Code: {response.status_code}\"\u001b[m)\u001b[38;9H\u001b[33mreturn\u001b[m \u001b[31m\"success!\"\u001b[m\r\n    \u001b[33melse\u001b[m:\u001b[40;9Hlogging.error(f\u001b[31m\"Error encountered during request on {HOST}, Code: {response.status_code}\"\u001b[m)\u001b[41;9H\u001b[33mreturn\u001b[m response.text\r\n\u001b[36mprint\u001b[m (set_interfaces(\u001b[31m\"interfaces/interface/\"\u001b[m, \u001b[31m\"GigabitEthernet3\"\u001b[m))\r\n\u001b[1m\u001b[34m~                                                                                                                   \u001b[44;1H~                                                                                                                   "]
