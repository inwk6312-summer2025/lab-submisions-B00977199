[4808.040827, "o", "\u001b[?25l\u001b[35mimport\u001b[m yaml\u001b[2;1H\u001b[K\u001b[58;99H2\u001b[2;1H\u001b[?25h"]
[4809.121373, "o", "\u001b[?25l\u001b[1;8Hjson\r\n\u001b[35mimport\u001b[m logging\u001b[3;1H\u001b[K\u001b[4;1H\u001b[34m# Setup logging\u001b[m\u001b[4;16H\u001b[K\u001b[5;1Hlogging.basicConfig(level=logging.INFO)\u001b[5;40H\u001b[K\u001b[6;1Hlogger = logging.getLogger()\u001b[6;29H\u001b[K\u001b[7;1H\u001b[K\u001b[8;1H\u001b[34m# RESTCONF headers and auth\u001b[m\u001b[8;28H\u001b[K\u001b[9;1HHEADERS = {\u001b[9;12H\u001b[K\u001b[10;1H        \u001b[31m\"Content-Type\"\u001b[m: \u001b[31m\"application/yang-data+json\"\u001b[m,\u001b[10;54H\u001b[K\u001b[11;1H        \u001b[31m\"Accept\"\u001b[m: \u001b[31m\"application/yang-data+json\"\u001b[m\u001b[11;47H\u001b[K\u001b[12;1H        }\u001b[12;10H\u001b[K\u001b[13;1HAUTH = (\u001b[31m\"admin\"\u001b[m, \u001b[31m\"admin\"\u001b[m)  \u001b[34m# Change if needed\u001b[m\u001b[13;46H\u001b[K\u001b[14;1H\u001b[K\u001b[15;1H\u001b[33mdef\u001b[m \u001b[36mload_config\u001b[m(file_path):\u001b[15;28H\u001b[K\u001b[16;1H    \u001b[33mwith\u001b[m \u001b[36mopen\u001b[m(file_path) \u001b[33mas\u001b[m f:\u001b[16;31H\u001b[K\u001b[17;1H        \u001b[33mreturn\u001b[m yaml.safe_load(f)\u001b[17;33H\u001b[K\u001b[18;1H\u001b[K\u001b[19;1H    \u001b[33mdef\u001b[m \u001b[36mset_interface_ip\u001b[m(router_ip, interface_name, ip_address, netmask):\u001b[19;74H\u001b[K\u001b[20;1H        url = f\u001b[31m\"http://{router_ip}/restconf/data/ietf-interfaces:interfaces/interface={interface_name}\"\u001b[m\u001b[20;104H\u001b[K\u001b[21;1H            \u001b["]
[4809.122894, "o", "21;13H\u001b[K\u001b[22;1H            \u001b[34m# Prepare payload according to RESTCONF yang model\u001b[m\u001b[22;63H\u001b[K\u001b[23;1H            data = {\u001b[23;21H\u001b[K\u001b[24;1H                    \u001b[31m\"ietf-interfaces:interface\"\u001b[m: {\u001b[24;51H\u001b[K\u001b[25;1H                        \u001b[31m\"name\"\u001b[m: interface_name,\u001b[25;48H\u001b[K\u001b[26;1H                        \u001b[31m\"description\"\u001b[m: \u001b[31m\"Configured via RESTCONF\"\u001b[m,\u001b[26;66H\u001b[K\u001b[27;1H                        \u001b[31m\"type\"\u001b[m: \u001b[31m\"iana-if-type:ethernetCsmacd\"\u001b[m,\u001b[27;63H\u001b[K\u001b[28;1H                        \u001b[31m\"enabled\"\u001b[m: \u001b[36mTrue\u001b[m,\u001b[28;41H\u001b[K\u001b[29;1H                        \u001b[31m\"ietf-ip:ipv4\"\u001b[m: {\u001b[29;42H\u001b[K\u001b[30;1H                            \u001b[31m\"address\"\u001b[m: [{\u001b[30;42H\u001b[K\u001b[31;1H                                \u001b[31m\"ip\"\u001b[m: ip_address,\u001b[31;50H\u001b[K\u001b[32;1H                                \u001b[31m\"netmask\"\u001b[m: netmask\u001b[32;51H\u001b[K\u001b[33;1H                                }]\u001b[33;35H\u001b[K\u001b[34;1H                            }\u001b[34;30H\u001b[K\u001b[35;1H                        }"]
[4809.128198, "o", "\u001b[35;26H\u001b[K\u001b[36;1H                    }  \u001b[36;24H\u001b[K\u001b[37;1H            \u001b[33mtry\u001b[m:\u001b[37;17H\u001b[K\u001b[38;1H                response = requests.put(url, auth=AUTH, headers=HEADERS, data=json.dumps(data))\u001b[38;96H\u001b[K\u001b[39;1H                \u001b[33mif\u001b[m response.status_code \u001b[33min\u001b[m [\u001b[31m200\u001b[m, \u001b[31m201\u001b[m, \u001b[31m204\u001b[m]:\u001b[39;60H\u001b[K\u001b[40;1H                    logger.info(f\u001b[31m\"Successfully set {interface_name} on {router_ip}\"\u001b[m)\u001b[40;85H\u001b[K\u001b[41;1H                \u001b[33melse\u001b[m:\u001b[41;22H\u001b[K\u001b[42;1H                    logger.error(f\u001b[31m\"Failed to set {interface_name} on {router_ip}, Status Code: {response.status_codee\u001b[43;1H}, Response: {response.text}\"\u001b[m)\u001b[43;31H\u001b[K\u001b[44;1H            \u001b[33mexcept\u001b[m requests.exceptions.RequestException \u001b[33mas\u001b[m e:\u001b[44;62H\u001b[K\u001b[45;1H                logger.error(f\u001b[31m\"Request failed for {router_ip}: {e}\"\u001b[m)\u001b[45;69H\u001b[K\u001b[46;1H                \u001b[33mdef\u001b[m \u001b[36mmain\u001b[m():\u001b[46;28H\u001b[K\u001b[47;1H                    config = load_config(\u001b[31m\"routers.yml\"\u001b[m)\u001b[47;56H\u001b[K\u001b[48;1H                    \u001b[33m"]
[4809.128622, "o", "for\u001b[m router \u001b[33min\u001b[m config.get(\u001b[31m'routers'\u001b[m, []):\u001b[48;61H\u001b[K\u001b[49;1H                        router_ip = router[\u001b[31m'management_ip'\u001b[m]\u001b[49;60H\u001b[K\u001b[50;1H                        \u001b[33mfor\u001b[m interface \u001b[33min\u001b[m router.get(\u001b[31m'interfaces'\u001b[m, []):\u001b[50;71H\u001b[K\u001b[51;1H                            set_interface_ip(router_ip, interface[\u001b[31m'name'\u001b[m], interface[\u001b[31m'ip_address'\u001b[m], interface[\u001b[31m'netmaa\u001b[52;1Hsk'\u001b[m])\u001b[52;6H\u001b[K\u001b[53;1H\u001b[K\u001b[54;1H                            \u001b[33mif\u001b[m __name__ == \u001b[31m\"__main__\"\u001b[m:\u001b[54;55H\u001b[K\u001b[55;1H                                    main()\u001b[55;43H\u001b[K\u001b[56;1H                                    \u001b[56;37H\u001b[K\u001b[58;99H56,37\u001b[9CBot\u001b[56;37H\u001b[?25h"]
