[1047.860195, "o", "\u001b[1;1H\u001b[35mimport\u001b[m logging\r\n\u001b[35mimport\u001b[m requests\r\n\u001b[35mfrom\u001b[m requests.auth \u001b[35mimport\u001b[m HTTPBasicAuth\r\n\u001b[35mimport\u001b[m json\r\nlogging.basicConfig(level=logging.INFO, \u001b[36mformat\u001b[m=\u001b[31m'%(name)s - %(levelname)s - %(message)s'\u001b[m)\r\nHOST = \u001b[31m'192.168.1.101'\u001b[m\r\nUSER = \u001b[31m'student'\u001b[m\r\nPASS = \u001b[31m'Meilab123'\u001b[m\r\nBASE_URL = \u001b[31m'http://{0}/restconf/api/running/'\u001b[m.format(HOST)\r\n\u001b[33mdef\u001b[m \u001b[36mget_interfaces\u001b[m(append_url, interface_name):\r\n    url = BASE_URL + append_url + interface_name\r\n    auth = HTTPBasicAuth(USER, PASS)\r\n    headers = {\u001b[31m'Accept'\u001b[m: \u001b[31m'application/vnd.yang.data+json'\u001b[m}\r\n    params = {\u001b[31m'deep'\u001b[m:\u001b[36mTrue\u001b[m}\r\n    logging.info(f\u001b[31m\"URL ==> {url}\"\u001b[m)\r\n    response = requests.get(url, auth=auth, headers=headers, params=params)\r\n    \u001b[33mif\u001b[m response.status_code == \u001b[31m200\u001b[m:\u001b[18;9Hlogging.info(f\u001b[31m\"Request was successful on {HOST}, Code: {response.status_code}\"\u001b[m)\u001b[19;9H\u001b[33mreturn\u001b[m json.dumps(response.json(), sort_keys=\u001b[36mTrue\u001b[m, indent=\u001b[31m4\u001b[m )"]
[1047.860642, "o", "\r\n    \u001b[33melse\u001b[m:\u001b[21;9Hlogging.error(f\u001b[31m\"Error encountered during request on {HOST}, Code: {response.status_code}\"\u001b[m)\u001b[22;9H\u001b[33mreturn\u001b[m response.text\r\n\u001b[36mprint\u001b[m (get_interfaces(\u001b[31m\"interfaces/interface/\"\u001b[m, \u001b[31m\"GigabitEthernet1?verbose\"\u001b[m))\r\n\u001b[1m\u001b[34m~                                                                                                                   \u001b[25;1H~                                                                                                                   \u001b[26;1H~                                                                                                                   \u001b[27;1H~                                                                                                                   \u001b[28;1H~                                                                                                                   \u001b[29;1H~                                                                                                                   "]
