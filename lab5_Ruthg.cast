[882.540881, "o", "ode: {response.status_code}\"\u001b[m)\u001b[21;9H\u001b[33mreturn\u001b[m response.text\r\n    \u001b[36mprint\u001b[m\u001b[46m(\u001b[mget_interfaces(\u001b[31m'interfaces'\u001b[m)\u001b[46m)\u001b[m\r\n\u001b[1m\u001b[34m~                                                                                                                   \u001b[24;1H~                                                                                                                   \u001b[25;1H~                                                                                                                   \u001b[26;1H~                                                                                                                   \u001b[27;1H~                                                                                                                   \u001b[28;1H~                                                                                                                   \u001b[29;1H~                                                                                                                   "]
